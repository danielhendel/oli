{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../../../..",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2020",
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "paths": {
      "@oli/contracts": ["lib/contracts/index.ts"],
      "@oli/contracts/*": ["lib/contracts/*"],
      "@oli/lib/*": ["lib/*"],
      "@/lib": ["lib/index.ts"],
      "@/lib/*": ["lib/*"],
      "@/*": ["app/*"]
    }
  },
  "include": ["./src/**/*.ts", "./tests/**/*.ts"]
}
